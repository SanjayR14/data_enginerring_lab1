# ENV: Set to "test" for isolated CI/local test execution.
ENV=development

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Airflow Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cloud_cost_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Airflow Orchestration Configuration
AIRFLOW_URL=http://localhost:8085
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow

# Databricks Configuration
DATABRICKS_HOST=https://dbc-9106afba-4500.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_token_here
DATABRICKS_WAREHOUSE_ID=your_warehouse_id
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=default

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Storage Configuration
UPLOAD_DIRECTORY=./data/uploads

# Kafka Streaming Configuration
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=cloud-cost-events
KAFKA_GROUP_ID=cloud-cost-consumer
KAFKA_DLQ_TOPIC=cloud-cost-events-dlq
